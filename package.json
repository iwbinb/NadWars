{
  "name": "nadwars",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:client": "node --test tests/game-client.test.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "check:worker": "tsc -p tsconfig.worker.json",
    "cf:types": "wrangler types cloudflare/worker-configuration.d.ts --strict-vars false",
    "cf:dev": "wrangler dev --port 8789",
    "cf:prepare": "npm run build && wrangler deploy --dry-run --outdir .wrangler/prepared",
    "test:protocol": "node --test tests/cloudflare-protocol.test.mjs",
    "pages:build": "npm run build && node scripts/prepare-pages-build.mjs",
    "pages:deploy": "wrangler pages deploy --cwd pages --project-name nadwars --branch main"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.56.3",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.0"
  }
}
