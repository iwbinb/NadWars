{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nadwars-staging",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "NETWORK": "testnet",
    "PUBLIC_RPC_URL": "https://rpc-testnet.monadinfra.com",
    "SPONSOR_ENABLED": "true"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DIRECTORY",
        "class_name": "RoomDirectory"
      },
      {
        "name": "ROOMS",
        "class_name": "RoomHub"
      },
      {
        "name": "SPONSORS",
        "class_name": "SponsorLane"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomDirectory",
        "RoomHub",
        "SponsorLane"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMIT",
      "namespace_id": "491304",
      "simple": {
        "limit": 1200,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  }
}
